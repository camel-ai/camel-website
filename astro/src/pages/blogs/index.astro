---
import BlogLayout from "@layouts/BlogLayout.astro";
import { getAllPosts, sortPostsByDateDesc } from "@utils/blog";

const allPosts = getAllPosts();
const posts = sortPostsByDateDesc(allPosts);

const categories = Array.from(
  new Set(posts.map((p) => p.data.category).filter(Boolean) as string[]),
);

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<BlogLayout
  title="Blog"
  description="CAMEL-AI blog: updates, tutorials, and insights on multi-agent systems, data generation, and AI research."
  canonical="/blogs"
  type="website"
>
  <!-- Page header -->
  <section class="border-b border-gray-200 dark:border-white/10 bg-white dark:bg-gray-900 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <h1
        class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
        style="font-family: var(--font-palatino);"
      >
        Blogs
      </h1>
      <p class="mt-3 text-base text-gray-500 dark:text-gray-400 max-w-2xl">
        Updates, tutorials, and insights on multi-agent systems, data generation, and AI research.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-7xl flex w-full flex-col gap-8 lg:flex-row lg:gap-0">
      <!-- Left sidebar: categories + social -->
      <aside
        class="h-fit w-full flex-shrink-0 lg:sticky lg:top-24 lg:mr-12 lg:w-44 lg:self-start"
      >
        <div class="flex flex-col gap-4 lg:gap-6">
          {
            categories.length > 0 && (
              <div class="flex flex-wrap gap-2 lg:flex-col" id="category-list">
                <button
                  type="button"
                  data-category=""
                  class="category-btn active rounded-md px-2 py-1.5 text-left text-sm transition-colors lg:rounded-none lg:px-0 font-semibold text-gray-900 dark:text-white bg-gray-100 dark:bg-white/10 lg:bg-transparent dark:lg:bg-transparent"
                >
                  All posts
                </button>
                {categories.map((cat) => (
                  <button
                    type="button"
                    data-category={cat}
                    class="category-btn rounded-md px-2 py-1.5 text-left text-sm transition-colors lg:rounded-none lg:px-0 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
                  >
                    {cat}
                  </button>
                ))}
              </div>
            )
          }

          <div class="border-t border-gray-200 dark:border-white/10 my-1 lg:my-2"></div>

          <!-- Social links -->
          <div class="flex flex-col gap-3">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Follow us</h3>
            <div class="flex flex-wrap gap-3 lg:flex-col lg:gap-2">
              {
                [
                  {
                    label: "GitHub",
                    href: "https://github.com/camel-ai/camel",
                    icon: '<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>',
                  },
                  {
                    label: "Twitter / X",
                    href: "https://twitter.com/camel_ai",
                    icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
                  },
                  {
                    label: "Discord",
                    href: "https://discord.gg/CNcNpquyDc",
                    icon: '<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>',
                  },
                ].map(({ label, href, icon }) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                    aria-label={label}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      set:html={icon}
                    />
                    <span>{label}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </aside>

      <!-- Blog post grid -->
      <div class="flex flex-1 flex-col gap-8">
        <p id="no-posts" class="hidden py-12 text-center text-gray-500 dark:text-gray-400">
          No posts found in this category.
        </p>

        <div
          id="posts-grid"
          class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8"
        >
          {
            posts.map((post, i) => (
              <a
                href={`/blogs/${post.slug}`}
                data-category={post.data.category || ""}
                data-index={i}
                class="blog-card group flex flex-col overflow-hidden rounded-2xl border border-transparent bg-white dark:bg-white/5 hover:border-amber-500/40 transition-colors"
                style={i >= 10 ? "display: none;" : ""}
              >
                <!-- Cover image -->
                <div class="relative h-48 w-full bg-gray-100 dark:bg-gray-800 sm:aspect-[16/9] sm:h-auto">
                  {post.data.thumbnail && (
                    <img
                      src={post.data.thumbnail}
                      alt={post.data.title}
                      loading={i < 6 ? "eager" : "lazy"}
                      decoding="async"
                      class="h-full w-full object-cover"
                      style="margin: 0; border-radius: 0; box-shadow: none;"
                    />
                  )}
                </div>

                <!-- Content -->
                <div class="flex flex-1 flex-col justify-between px-4 py-4 sm:px-6">
                  <div class="flex flex-col gap-3">
                    <!-- Category + date -->
                    <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                      {post.data.category && (
                        <>
                          <span class="uppercase tracking-wide">{post.data.category}</span>
                          <span>•</span>
                        </>
                      )}
                      <span class="uppercase tracking-wide">{formatDate(post.data.date)}</span>
                    </div>

                    <!-- Title -->
                    <h2 class="line-clamp-2 text-xl font-semibold text-gray-900 dark:text-white group-hover:underline sm:text-2xl" style="font-family: var(--font-palatino);">
                      {post.data.title}
                    </h2>

                    <!-- Description -->
                    {post.data.description && (
                      <p class="line-clamp-3 text-xs text-gray-500 dark:text-gray-400 sm:text-sm">
                        {post.data.description}
                      </p>
                    )}
                  </div>

                  <!-- Author -->
                  {post.data.author && (
                    <div class="mt-4 flex items-center gap-2 border-t border-gray-100 dark:border-white/10 pt-4">
                      {post.authorData?.avatar && (
                        <img
                          src={post.authorData.avatar}
                          alt={post.authorData.name}
                          width="20"
                          height="20"
                          loading="lazy"
                          class="h-5 w-5 shrink-0 rounded-full object-cover"
                          style="margin: 0; border-radius: 9999px; box-shadow: none;"
                        />
                      )}
                      <span class="text-xs text-gray-500 dark:text-gray-400">
                        {post.authorData?.name || post.data.author}
                      </span>
                    </div>
                  )}
                </div>
              </a>
            ))
          }
        </div>

        <!-- Load more sentinel / button -->
        <div id="load-more-btn" class="hidden text-center">
          <button
            type="button"
            class="rounded-lg border border-gray-200 dark:border-white/10 px-6 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors"
          >
            Load more posts
          </button>
        </div>
      </div>
    </div>
  </section>
</BlogLayout>

<script>
  const INITIAL = 10;
  const STEP = 10;

  const cards = Array.from(document.querySelectorAll<HTMLElement>(".blog-card"));
  const noPostsMsg = document.getElementById("no-posts")!;
  const loadMoreContainer = document.getElementById("load-more-btn")!;
  const loadMoreBtn = loadMoreContainer.querySelector("button")!;
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>(".category-btn");

  let currentCategory = "";
  let visibleCount = INITIAL;

  function getFiltered() {
    if (!currentCategory) return cards;
    return cards.filter((c) => c.dataset.category === currentCategory);
  }

  function render() {
    const filtered = getFiltered();
    let shown = 0;
    cards.forEach((card) => {
      const inFilter = !currentCategory || card.dataset.category === currentCategory;
      const inWindow = shown < visibleCount && inFilter;
      card.style.display = inWindow ? "" : "none";
      if (inWindow) shown++;
    });
    noPostsMsg.classList.toggle("hidden", filtered.length > 0);
    const hasMore = visibleCount < filtered.length;
    loadMoreContainer.classList.toggle("hidden", !hasMore);
  }

  categoryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      currentCategory = btn.dataset.category ?? "";
      visibleCount = INITIAL;
      categoryBtns.forEach((b) => {
        const active = b.dataset.category === currentCategory;
        b.classList.toggle("active", active);
        b.classList.toggle("font-semibold", active);
        b.classList.toggle("text-gray-900", active);
        b.classList.toggle("dark:text-white", active);
        b.classList.toggle("bg-gray-100", active);
        b.classList.toggle("dark:bg-white/10", active);
        b.classList.toggle("text-gray-500", !active);
        b.classList.toggle("dark:text-gray-400", !active);
      });
      render();
    });
  });

  loadMoreBtn.addEventListener("click", () => {
    visibleCount += STEP;
    render();
  });

  // Initial render: hide cards past INITIAL
  render();
</script>
