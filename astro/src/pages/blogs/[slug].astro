---
import BlogLayout from "@layouts/BlogLayout.astro";
import { getAllPosts, sortPostsByDateDesc, buildSeoMeta } from "@utils/blog";
import { renderMarkdown } from "@utils/markdown";

export async function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { slug } = Astro.params;

if (!post) {
  return Astro.redirect("/blogs");
}

const seo = buildSeoMeta(post);
const renderedContent = renderMarkdown(post.content);

const allPosts = getAllPosts();
const recentPosts = sortPostsByDateDesc(allPosts)
  .filter((p) => p.slug !== slug)
  .slice(0, 3);

const authorInfo = post.authorData || {
  name: post.data.author || "Anonymous",
  avatar: post.data.authorprofile,
  avatarDark: undefined,
  role: post.data.role || "Author",
};

function formatDate(dateStr: string, opts?: Intl.DateTimeFormatOptions) {
  return new Date(dateStr).toLocaleDateString(
    "en-US",
    opts || { year: "numeric", month: "long", day: "numeric" },
  );
}
---

<BlogLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  canonical={`/blogs/${slug}`}
  keywords={seo.keywords}
  publishedDate={seo.date}
  author={seo.author}
  type="article"
>
  <article class="py-8 sm:py-12">

    <!-- Page layout: TOC left + centered content -->
    <div class="flex justify-center gap-10 px-4 sm:px-6">

      <!-- ── Left TOC (desktop only, ≥1024px) ── -->
      {post.toc.length > 0 && (
        <aside class="hidden lg:block w-52 xl:w-60 flex-shrink-0">
          <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
            <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500">
              On this page
            </p>
            <nav>
              <ul class="space-y-1">
                {post.toc.map((item) => (
                  <li style={`padding-left: ${(item.depth - 1) * 10}px;`}>
                    <a
                      href={`#${item.slug}`}
                      class="toc-link block py-0.5 text-sm leading-snug text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-150"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      )}

      <!-- ── Main content column (max 800px) ── -->
      <div class="min-w-0 w-full max-w-[800px]">

        <!-- Back + breadcrumb -->
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <a
            href="/blogs"
            class="inline-flex h-8 items-center gap-1.5 rounded-md border border-gray-200 dark:border-white/10 px-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m12 19-7-7 7-7" />
              <path d="M19 12H5" />
            </svg>
            Back
          </a>
          {post.data.category && (
            <span class="text-xs font-medium uppercase tracking-wider text-gray-400 dark:text-gray-500">
              {post.data.category}
            </span>
          )}
        </div>

        <!-- ── Post header ── -->
        <header class="mb-8">

          <!-- Title -->
          <h1
            class="mb-3 text-3xl font-bold leading-tight text-gray-900 dark:text-white sm:text-4xl"
            style="font-family: var(--font-palatino);"
          >
            {post.data.title}
          </h1>

          <!-- Subtitle -->
          {post.data.subtitle && (
            <p class="mb-5 text-lg leading-relaxed text-gray-500 dark:text-gray-400">
              {post.data.subtitle}
            </p>
          )}

          <!-- Date | reading time | author -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
            {post.data.date && (
              <span>{formatDate(post.data.date)}</span>
            )}
            <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">|</span>
            <span class="inline-flex items-center gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              {post.readingTime} min read
            </span>
            <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">|</span>
            <span class="inline-flex items-center gap-1.5">
              {authorInfo.avatar && (
                <>
                  <img
                    src={authorInfo.avatar}
                    alt={authorInfo.name}
                    width="20"
                    height="20"
                    loading="eager"
                    class={`h-5 w-5 shrink-0 rounded-full object-cover ${authorInfo.avatarDark ? "dark:hidden" : ""}`}
                    style="margin: 0; border-radius: 9999px; box-shadow: none;"
                  />
                  {authorInfo.avatarDark && (
                    <img
                      src={authorInfo.avatarDark}
                      alt={authorInfo.name}
                      width="20"
                      height="20"
                      loading="eager"
                      class="hidden h-5 w-5 shrink-0 rounded-full object-contain dark:block"
                      style="margin: 0; border-radius: 9999px; box-shadow: none;"
                    />
                  )}
                </>
              )}
              <span>{authorInfo.name}</span>
            </span>
          </div>

          <!-- Thumbnail image -->
          {post.data.thumbnail && (
            <div class="mt-8 w-full overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
              <img
                src={post.data.thumbnail}
                alt={post.data.title}
                width="800"
                height="450"
                loading="eager"
                decoding="async"
                class="w-full object-cover"
                style="margin: 0; border-radius: 0.75rem; box-shadow: none; display: block; aspect-ratio: 16/9;"
              />
            </div>
          )}
        </header>

        <!-- ── Blog prose content ── -->
        <div class="blog-prose" set:html={renderedContent} />

        <!-- ── Recent posts ── -->
        {recentPosts.length > 0 && (
          <section class="mt-16 border-t border-gray-200 dark:border-white/10 pt-12">
            <h2
              class="mb-8 text-2xl font-bold text-gray-900 dark:text-white"
              style="font-family: var(--font-palatino);"
            >
              Recent Posts
            </h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {recentPosts.map((p) => (
                <a
                  href={`/blogs/${p.slug}`}
                  class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20 transition-colors"
                >
                  <div class="relative aspect-video w-full bg-gray-100 dark:bg-gray-800">
                    {p.data.thumbnail && (
                      <img
                        src={p.data.thumbnail}
                        alt={p.data.title}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                        style="margin: 0; border-radius: 0; box-shadow: none;"
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-4">
                    <div class="mb-2 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                      {p.data.category && (
                        <span class="rounded border border-gray-200 dark:border-white/10 px-1 py-0.5 text-[10px] font-medium uppercase">
                          {p.data.category}
                        </span>
                      )}
                      <span class="ml-auto uppercase tracking-wide">
                        {formatDate(p.data.date, { year: "numeric", month: "short", day: "numeric" })}
                      </span>
                    </div>
                    <h3 class="mb-1 line-clamp-2 text-base font-semibold text-gray-900 dark:text-white group-hover:underline">
                      {p.data.title}
                    </h3>
                    {p.data.description && (
                      <p class="line-clamp-2 text-xs text-gray-500 dark:text-gray-400">
                        {p.data.description}
                      </p>
                    )}
                    <div class="mt-auto flex items-center gap-2 pt-3 text-xs text-gray-500 dark:text-gray-400">
                      {p.authorData?.avatar && (
                        <img
                          src={p.authorData.avatar}
                          alt={p.authorData.name}
                          width="16"
                          height="16"
                          loading="lazy"
                          class="h-4 w-4 shrink-0 rounded-full object-cover"
                          style="margin: 0; border-radius: 9999px; box-shadow: none;"
                        />
                      )}
                      <span>{p.authorData?.name || p.data.author}</span>
                      <span class="ml-auto">{p.readingTime} min</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </div><!-- end main content column -->
    </div><!-- end flex row -->

  </article>
</BlogLayout>

<script>
  // Highlight active TOC item as user scrolls
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");

  if (tocLinks.length > 0) {
    const headingIds = Array.from(tocLinks).map((l) => l.getAttribute("href")?.slice(1) ?? "");
    const headingEls = headingIds
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    function setActive(id: string) {
      tocLinks.forEach((l) => {
        const active = l.getAttribute("href") === `#${id}`;
        l.classList.toggle("text-gray-900", active);
        l.classList.toggle("dark:text-white", active);
        l.classList.toggle("font-medium", active);
        l.classList.toggle("text-gray-500", !active);
        l.classList.toggle("dark:text-gray-400", !active);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 },
    );

    headingEls.forEach((el) => observer.observe(el));
  }
</script>
